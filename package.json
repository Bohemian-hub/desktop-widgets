{
  "name": "desktop-widgets-electron",
  "productName": "桌面组件",
  "version": "0.2.0",
  "description": "基于 Electron 的 macOS 桌面组件系统：每个组件一个独立透明窗口，组件区域可点击，桌面其余区域正常可用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "gen-icon": "node scripts/gen-icon.js",
    "package": "electron-packager . 桌面组件 --platform=darwin --arch=arm64 --icon=assets/app-icon.icns --out=dist --overwrite --app-bundle-id=com.bohemian.desktopwidgets --app-version=0.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-packager": "^17.1.2"
  }
}
